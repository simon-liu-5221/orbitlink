# Copy to .env for local development:  cp .env.example .env
# docker-compose.yml reads these. Never commit the real .env (rule 6 in CLAUDE.md).

# --- Secrets -------------------------------------------------------------------
# Generate strong values for anything you deploy:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# These placeholders work in development; ENVIRONMENT=production refuses to boot
# with them, or with anything shorter than 32 bytes.
JWT_SECRET=dev-only-insecure-change-me-0123
PSEUDONYM_KEY=dev-only-insecure-change-me

# YouTube Data API v3 key. Needed from M2 onward; leave blank for M0/M1.
YOUTUBE_API_KEY=

# --- Auth / email (M3) ---------------------------------------------------------
# Where the verification and password-reset links point.
# FRONTEND_BASE_URL=http://localhost:5173
# "log" writes the email to the application log (default, needs nothing running);
# "smtp" talks to MailHog in compose — inbox at http://localhost:8025.
# EMAIL_BACKEND=log
# The refresh cookie: HTTPS-only in production, plain HTTP locally.
# COOKIE_SECURE=false

# --- Infrastructure (local defaults already baked into docker-compose.yml) ----
# Override only if you point at external Postgres / Redis instead of compose.
# DATABASE_URL=postgresql+psycopg://orbitlink:orbitlink@localhost:15432/orbitlink
# REDIS_URL=redis://localhost:16379/0
