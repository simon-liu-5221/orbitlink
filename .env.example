# Copy to .env for local development:  cp .env.example .env
# docker-compose.yml reads these. Never commit the real .env (rule 6 in CLAUDE.md).

# --- Secrets -------------------------------------------------------------------
# Generate strong values for anything you deploy:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

JWT_SECRET=dev-only-insecure-change-me
PSEUDONYM_KEY=dev-only-insecure-change-me

# YouTube Data API v3 key. Needed from M2 onward; leave blank for M0/M1.
YOUTUBE_API_KEY=

# --- Infrastructure (local defaults already baked into docker-compose.yml) ----
# Override only if you point at external Postgres / Redis instead of compose.
# DATABASE_URL=postgresql+psycopg://orbitlink:orbitlink@localhost:5432/orbitlink
# REDIS_URL=redis://localhost:6379/0
